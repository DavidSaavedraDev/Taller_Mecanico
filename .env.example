# Copia este archivo como .env y reemplaza los valores.
# Para Gmail, SMTP_PASS debe ser una contraseña de aplicación de 16 caracteres,
# no la contraseña normal de la cuenta.
DB_HOST=localhost
DB_NAME=taller_mecanico
DB_USER=root
DB_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
MAIL_FROM=tu-correo@gmail.com
SMTP_DEBUG=true
